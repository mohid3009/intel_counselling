# Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://mindbridge:mindbridge_secret@localhost:5432/mindbridge_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_access_secret_here_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_64_chars

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=MindBridge <noreply@mindbridge.app>

# Twilio SMS (optional)
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM=+1234567890

# App
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
